        "description":"Combine Builder and Strategy patterns.\nThe Builder pattern constructs complex objects step by step, while the Strategy pattern defines different algorithms for the building process.\nThis combination allows for flexible object construction where both the structure and the construction algorithm can vary independently.\n\nExample:\nfrom __future__ import annotations\nfrom abc import ABC, abstractmethod\nfrom typing import List\n\n# Product\nclass Coffee:\n    def __init__(self) -> None:\n        self._components: List[str] = []\n        self._brewing_method: str = \"\"\n        self._strength: str = \"\"\n        self._temperature: str = \"\"\n    \n    def add_component(self, component: str) -> None:\n        self._components.append(component)\n    \n    def set_brewing_method(self, method: str) -> None:\n        self._brewing_method = method\n    \n    def set_strength(self, strength: str) -> None:\n        self._strength = strength\n    \n    def set_temperature(self, temperature: str) -> None:\n        self._temperature = temperature\n    \n    def describe(self) -> None:\n        print(f\"Coffee: {self._brewing_method}\")\n        print(f\"Strength: {self._strength}\")\n        print(f\"Temperature: {self._temperature}\")\n        print(f\"Components: {', '.join(self._components)}\")\n\n# Strategy Interface\nclass BrewingStrategy(ABC):\n    @abstractmethod\n    def prepare_beans(self, builder: CoffeeBuilder) -> None:\n        pass\n    \n    @abstractmethod\n    def set_brewing_parameters(self, builder: CoffeeBuilder) -> None:\n        pass\n    \n    @abstractmethod\n    def add_extras(self, builder: CoffeeBuilder) -> None:\n        pass\n\n# Concrete Strategies\nclass EspressoStrategy(BrewingStrategy):\n    def prepare_beans(self, builder: CoffeeBuilder) -> None:\n        builder.add_component(\"Finely ground arabica beans\")\n        builder.set_brewing_method(\"Espresso\")\n    \n    def set_brewing_parameters(self, builder: CoffeeBuilder) -> None:\n        builder.set_strength(\"Strong\")\n        builder.set_temperature(\"Hot (90°C)\")\n    \n    def add_extras(self, builder: CoffeeBuilder) -> None:\n        builder.add_component(\"Crema layer\")\n\nclass ColdBrewStrategy(BrewingStrategy):\n    def prepare_beans(self, builder: CoffeeBuilder) -> None:\n        builder.add_component(\"Coarsely ground coffee beans\")\n        builder.set_brewing_method(\"Cold Brew\")\n    \n    def set_brewing_parameters(self, builder: CoffeeBuilder) -> None:\n        builder.set_strength(\"Medium\")\n        builder.set_temperature(\"Cold (4°C)\")\n    \n    def add_extras(self, builder: CoffeeBuilder) -> None:\n        builder.add_component(\"Ice cubes\")\n        builder.add_component(\"Cold water\")\n\nclass FrenchPressStrategy(BrewingStrategy):\n    def prepare_beans(self, builder: CoffeeBuilder) -> None:\n        builder.add_component(\"Medium ground coffee beans\")\n        builder.set_brewing_method(\"French Press\")\n    \n    def set_brewing_parameters(self, builder: CoffeeBuilder) -> None:\n        builder.set_strength(\"Medium-Strong\")\n        builder.set_temperature(\"Hot (85°C)\")\n    \n    def add_extras(self, builder: CoffeeBuilder) -> None:\n        builder.add_component(\"Hot water\")\n        builder.add_component(\"4-minute steep time\")\n\n# Builder with Strategy\nclass CoffeeBuilder:\n    def __init__(self, strategy: BrewingStrategy) -> None:\n        self._strategy: BrewingStrategy = strategy\n        self._coffee: Coffee = Coffee()\n    \n    def set_strategy(self, strategy: BrewingStrategy) -> None:\n        self._strategy = strategy\n    \n    def add_component(self, component: str) -> None:\n        self._coffee.add_component(component)\n    \n    def set_brewing_method(self, method: str) -> None:\n        self._coffee.set_brewing_method(method)\n    \n    def set_strength(self, strength: str) -> None:\n        self._coffee.set_strength(strength)\n    \n    def set_temperature(self, temperature: str) -> None:\n        self._coffee.set_temperature(temperature)\n    \n    def brew_coffee(self) -> None:\n        print(f\"Building coffee using {self._strategy.__class__.__name__}...\")\n        self._strategy.prepare_beans(self)\n        self._strategy.set_brewing_parameters(self)\n        self._strategy.add_extras(self)\n    \n    def get_coffee(self) -> Coffee:\n        result = self._coffee\n        self._coffee = Coffee()\n        return result\n\n# Client\ndef main() -> None:\n    # Create builder with espresso strategy\n    builder = CoffeeBuilder(EspressoStrategy())\n    \n    # Build espresso\n    builder.brew_coffee()\n    espresso = builder.get_coffee()\n    espresso.describe()\n    # Coffee: Espresso\n    # Strength: Strong\n    # Temperature: Hot (90°C)\n    # Components: Finely ground arabica beans, Crema layer\n    \n    print(\"\\n\" + \"=\"*50 + \"\\n\")\n    \n    # Change strategy to cold brew\n    builder.set_strategy(ColdBrewStrategy())\n    builder.brew_coffee()\n    cold_brew = builder.get_coffee()\n    cold_brew.describe()\n    # Coffee: Cold Brew\n    # Strength: Medium\n    # Temperature: Cold (4°C)\n    # Components: Coarsely ground coffee beans, Ice cubes, Cold water\n    \n    print(\"\\n\" + \"=\"*50 + \"\\n\")\n    \n    # Change strategy to french press\n    builder.set_strategy(FrenchPressStrategy())\n    builder.brew_coffee()\n    french_press = builder.get_coffee()\n    french_press.describe()\n    # Coffee: French Press\n    # Strength: Medium-Strong\n    # Temperature: Hot (85°C)\n    # Components: Medium ground coffee beans, Hot water, 4-minute steep time\n\nif __name__ == \"__main__\":\n    main()"
