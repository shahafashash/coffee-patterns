            "from __future__ import annotations",
            "from abc import ABC, abstractmethod",
            "from typing import Optional",
            "",
            "# Component Interface",
            "class ${1:Component}(ABC):",
            "    \"\"\"",
            "    Abstract base class for components that can be decorated.",
            "    \"\"\"",
            "    @abstractmethod",
            "    def ${2:operation}(self) -> str:",
            "        \"\"\"",
            "        Abstract operation method.",
            "        ",
            "        Returns:",
            "            str: Result of the operation.",
            "        \"\"\"",
            "        pass",
            "",
            "# Concrete Component",
            "class ${3:ConcreteComponent}(${1:Component}):",
            "    \"\"\"",
            "    Concrete component implementing the base functionality.",
            "    \"\"\"",
            "    def ${2:operation}(self) -> str:",
            "        return \"BaseComponent\"",
            "",
            "# Base Decorator (also acts as Handler in Chain)",
            "class ${4:BaseDecorator}(${1:Component}):",
            "    \"\"\"",
            "    Base decorator class that also serves as a handler in the chain of responsibility.",
            "    \"\"\"",
            "    def __init__(self, component: ${1:Component}) -> None:",
            "        \"\"\"",
            "        Initialize the decorator with a component.",
            "        ",
            "        Args:",
            "            component (Component): The component to decorate.",
            "        \"\"\"",
            "        self._component: ${1:Component} = component",
            "        self._next_handler: Optional[${4:BaseDecorator}] = None",
            "",
            "    def set_next(self, handler: ${4:BaseDecorator}) -> ${4:BaseDecorator}:",
            "        \"\"\"",
            "        Set the next handler in the chain.",
            "        ",
            "        Args:",
            "            handler (BaseDecorator): The next handler in the chain.",
            "        ",
            "        Returns:",
            "            BaseDecorator: The handler that was set as next.",
            "        \"\"\"",
            "        self._next_handler = handler",
            "        return handler",
            "",
            "    def ${2:operation}(self) -> str:",
            "        \"\"\"",
            "        Default operation that delegates to the wrapped component.",
            "        ",
            "        Returns:",
            "            str: Result of the operation.",
            "        \"\"\"",
            "        result = self._component.${2:operation}()",
            "        return self._process_request(result)",
            "",
            "    def _process_request(self, request: str) -> str:",
            "        \"\"\"",
            "        Process the request and potentially pass it to the next handler.",
            "        ",
            "        Args:",
            "            request (str): The request to process.",
            "        ",
            "        Returns:",
            "            str: The processed request.",
            "        \"\"\"",
            "        processed = self._handle_request(request)",
            "        ",
            "        if self._next_handler and self._should_continue(processed):",
            "            return self._next_handler._process_request(processed)",
            "        return processed",
            "",
            "    @abstractmethod",
            "    def _handle_request(self, request: str) -> str:",
            "        \"\"\"",
            "        Handle the specific processing for this decorator.",
            "        ",
            "        Args:",
            "            request (str): The request to handle.",
            "        ",
            "        Returns:",
            "            str: The handled request.",
            "        \"\"\"",
            "        pass",
            "",
            "    def _should_continue(self, request: str) -> bool:",
            "        \"\"\"",
            "        Determine if the request should continue to the next handler.",
            "        ",
            "        Args:",
            "            request (str): The current request state.",
            "        ",
            "        Returns:",
            "            bool: True if processing should continue, False otherwise.",
            "        \"\"\"",
            "        return True",
            "",
            "# Concrete Decorators",
            "class ${5:ConcreteDecoratorA}(${4:BaseDecorator}):",
            "    \"\"\"",
            "    Concrete decorator implementing specific functionality.",
            "    \"\"\"",
            "    def _handle_request(self, request: str) -> str:",
            "        return f\"DecoratorA({request})\"",
            "",
            "class ${6:ConcreteDecoratorB}(${4:BaseDecorator}):",
            "    \"\"\"",
            "    Another concrete decorator implementing different functionality.",
            "    \"\"\"",
            "    def _handle_request(self, request: str) -> str:",
            "        return f\"DecoratorB({request})\"",
            "",
            "class ${7:ConcreteDecoratorC}(${4:BaseDecorator}):",
            "    \"\"\"",
            "    A third concrete decorator with conditional processing.",
            "    \"\"\"",
            "    def _handle_request(self, request: str) -> str:",
            "        return f\"DecoratorC({request})\"",
            "",
            "    def _should_continue(self, request: str) -> bool:",
            "        # Example: Stop chain if request contains certain keyword",
            "        return \"STOP\" not in request",
            ""
        ],
        "description":"Combine Decorator and Chain of Responsibility patterns.\nThe Decorator pattern adds behavior to objects dynamically, while Chain of Responsibility passes requests along a chain of handlers.\nThis combination creates a processing pipeline where each decorator both modifies the object and acts as a handler in the chain.\n\nExample:\nfrom __future__ import annotations\nfrom abc import ABC, abstractmethod\nfrom typing import Optional\n\n# Component Interface\nclass CoffeeOrder(ABC):\n    @abstractmethod\n    def process(self) -> str:\n        pass\n    \n    @abstractmethod\n    def get_price(self) -> float:\n        pass\n\n# Concrete Component\nclass BasicCoffeeOrder(CoffeeOrder):\n    def __init__(self, coffee_type: str, base_price: float) -> None:\n        self._coffee_type: str = coffee_type\n        self._base_price: float = base_price\n    \n    def process(self) -> str:\n        return f\"Basic order: {self._coffee_type}\"\n    \n    def get_price(self) -> float:\n        return self._base_price\n\n# Base Decorator/Handler\nclass OrderProcessor(CoffeeOrder):\n    def __init__(self, order: CoffeeOrder) -> None:\n        self._order: CoffeeOrder = order\n        self._next_processor: Optional[OrderProcessor] = None\n        self._processing_fee: float = 0.0\n    \n    def set_next(self, processor: OrderProcessor) -> OrderProcessor:\n        self._next_processor = processor\n        return processor\n    \n    def process(self) -> str:\n        result = self._order.process()\n        processed = self._handle_processing(result)\n        \n        if self._next_processor and self._should_continue(processed):\n            # Create new decorated order for next processor\n            temp_order = BasicCoffeeOrder(processed, self.get_price())\n            decorated_next = self._next_processor\n            decorated_next._order = temp_order\n            return decorated_next.process()\n        \n        return processed\n    \n    def get_price(self) -> float:\n        return self._order.get_price() + self._processing_fee\n    \n    @abstractmethod\n    def _handle_processing(self, order_details: str) -> str:\n        pass\n    \n    def _should_continue(self, order_details: str) -> bool:\n        return True\n\n# Concrete Decorators/Handlers\nclass SizeUpgradeProcessor(OrderProcessor):\n    def __init__(self, order: CoffeeOrder) -> None:\n        super().__init__(order)\n        self._processing_fee = 1.50\n    \n    def _handle_processing(self, order_details: str) -> str:\n        if \"small\" in order_details.lower():\n            return order_details.replace(\"small\", \"large\") + \" [Size upgraded]\"\n        return order_details + \" [Large size applied]\"\n\nclass MilkAlternativeProcessor(OrderProcessor):\n    def __init__(self, order: CoffeeOrder) -> None:\n        super().__init__(order)\n        self._processing_fee = 0.75\n    \n    def _handle_processing(self, order_details: str) -> str:\n        if \"latte\" in order_details.lower() or \"cappuccino\" in order_details.lower():\n            return order_details + \" [Oat milk substituted]\"\n        return order_details\n\nclass ExtraShotProcessor(OrderProcessor):\n    def __init__(self, order: CoffeeOrder) -> None:\n        super().__init__(order)\n        self._processing_fee = 1.00\n    \n    def _handle_processing(self, order_details: str) -> str:\n        if \"espresso\" in order_details.lower() or \"americano\" in order_details.lower():\n            return order_details + \" [Extra shot added]\"\n        return order_details\n\nclass LoyaltyDiscountProcessor(OrderProcessor):\n    def __init__(self, order: CoffeeOrder, is_member: bool = False) -> None:\n        super().__init__(order)\n        self._is_member: bool = is_member\n        self._processing_fee = -0.50 if is_member else 0.0  # Discount for members\n    \n    def _handle_processing(self, order_details: str) -> str:\n        if self._is_member:\n            return order_details + \" [Loyalty discount applied]\"\n        return order_details\n\nclass QualityCheckProcessor(OrderProcessor):\n    def __init__(self, order: CoffeeOrder) -> None:\n        super().__init__(order)\n        self._processing_fee = 0.0\n    \n    def _handle_processing(self, order_details: str) -> str:\n        return order_details + \" [Quality checked ✓]\"\n    \n    def _should_continue(self, order_details: str) -> bool:\n        # Stop processing if quality check fails\n        return \"REJECT\" not in order_details\n\n# Client\ndef main() -> None:\n    # Create basic coffee order\n    basic_order = BasicCoffeeOrder(\"Small Latte\", 4.50)\n    \n    print(\"Original order:\")\n    print(f\"Order: {basic_order.process()}\")\n    print(f\"Price: ${basic_order.get_price():.2f}\")\n    print()\n    \n    # Create processing chain with decorators\n    size_processor = SizeUpgradeProcessor(basic_order)\n    milk_processor = MilkAlternativeProcessor(basic_order)\n    shot_processor = ExtraShotProcessor(basic_order)\n    loyalty_processor = LoyaltyDiscountProcessor(basic_order, is_member=True)\n    quality_processor = QualityCheckProcessor(basic_order)\n    \n    # Build the chain\n    size_processor.set_next(milk_processor).set_next(shot_processor).set_next(loyalty_processor).set_next(quality_processor)\n    \n    print(\"Processed order:\")\n    print(f\"Order: {size_processor.process()}\")\n    print(f\"Final price: ${size_processor.get_price():.2f}\")\n    print()\n    \n    # Demonstrate with different order\n    espresso_order = BasicCoffeeOrder(\"Double Espresso\", 3.00)\n    \n    # Create new chain for espresso\n    espresso_size = SizeUpgradeProcessor(espresso_order)\n    espresso_shot = ExtraShotProcessor(espresso_order)\n    espresso_quality = QualityCheckProcessor(espresso_order)\n    \n    espresso_size.set_next(espresso_shot).set_next(espresso_quality)\n    \n    print(\"Espresso order processing:\")\n    print(f\"Order: {espresso_size.process()}\")\n    print(f\"Final price: ${espresso_size.get_price():.2f}\")\n\nif __name__ == \"__main__\":\n    main()"
    },
