        "description":"Combine State and Command patterns.\nThe State pattern allows an object to alter its behavior when its internal state changes, while the Command pattern encapsulates requests as objects.\nThis combination enables state-dependent command execution where available commands and their behavior change based on the current state.\n\nExample:\nfrom __future__ import annotations\nfrom abc import ABC, abstractmethod\nfrom typing import Dict, List\n\n# Command Interface\nclass CoffeeCommand(ABC):\n    @abstractmethod\n    def execute(self, machine: CoffeeMachine) -> None:\n        pass\n    \n    @abstractmethod\n    def can_execute(self, machine: CoffeeMachine) -> bool:\n        pass\n\n# State Interface\nclass CoffeeMachineState(ABC):\n    @abstractmethod\n    def handle_command(self, machine: CoffeeMachine, command: CoffeeCommand) -> None:\n        pass\n    \n    @abstractmethod\n    def get_available_commands(self) -> List[str]:\n        pass\n    \n    @abstractmethod\n    def get_status(self) -> str:\n        pass\n\n# Context (Coffee Machine)\nclass CoffeeMachine:\n    def __init__(self) -> None:\n        self._state: CoffeeMachineState = IdleState()\n        self._commands: Dict[str, CoffeeCommand] = {}\n        self._water_level: int = 100\n        self._beans_level: int = 100\n        self._current_coffee: str = \"\"\n        self._maintenance_cycles: int = 0\n    \n    def transition_to(self, state: CoffeeMachineState) -> None:\n        print(f\"Machine: Transitioning to {state.__class__.__name__}\")\n        self._state = state\n    \n    def register_command(self, name: str, command: CoffeeCommand) -> None:\n        self._commands[name] = command\n    \n    def execute_command(self, command_name: str) -> None:\n        if command_name in self._commands:\n            command = self._commands[command_name]\n            self._state.handle_command(self, command)\n        else:\n            print(f\"Unknown command: {command_name}\")\n    \n    def get_status(self) -> str:\n        return (f\"State: {self._state.get_status()}\\n\"\n                f\"Water: {self._water_level}%\\n\"\n                f\"Beans: {self._beans_level}%\\n\"\n                f\"Current Coffee: {self._current_coffee}\\n\"\n                f\"Maintenance Cycles: {self._maintenance_cycles}\")\n    \n    def get_available_commands(self) -> List[str]:\n        return self._state.get_available_commands()\n    \n    # Machine properties\n    @property\n    def water_level(self) -> int:\n        return self._water_level\n    \n    @water_level.setter\n    def water_level(self, level: int) -> None:\n        self._water_level = max(0, min(100, level))\n    \n    @property\n    def beans_level(self) -> int:\n        return self._beans_level\n    \n    @beans_level.setter\n    def beans_level(self, level: int) -> None:\n        self._beans_level = max(0, min(100, level))\n    \n    @property\n    def current_coffee(self) -> str:\n        return self._current_coffee\n    \n    @current_coffee.setter\n    def current_coffee(self, coffee: str) -> None:\n        self._current_coffee = coffee\n    \n    @property\n    def maintenance_cycles(self) -> int:\n        return self._maintenance_cycles\n    \n    def increment_maintenance_cycles(self) -> None:\n        self._maintenance_cycles += 1\n\n# Concrete Commands\nclass BrewEspressoCommand(CoffeeCommand):\n    def execute(self, machine: CoffeeMachine) -> None:\n        print(\"Brewing espresso...\")\n        machine.current_coffee = \"Espresso\"\n        machine.water_level -= 10\n        machine.beans_level -= 15\n        machine.increment_maintenance_cycles()\n        machine.transition_to(BrewingState())\n    \n    def can_execute(self, machine: CoffeeMachine) -> bool:\n        return (machine.water_level >= 10 and \n                machine.beans_level >= 15 and\n                isinstance(machine.get_current_state(), IdleState))\n\nclass BrewAmericanoCommand(CoffeeCommand):\n    def execute(self, machine: CoffeeMachine) -> None:\n        print(\"Brewing americano...\")\n        machine.current_coffee = \"Americano\"\n        machine.water_level -= 20\n        machine.beans_level -= 10\n        machine.increment_maintenance_cycles()\n        machine.transition_to(BrewingState())\n    \n    def can_execute(self, machine: CoffeeMachine) -> bool:\n        return (machine.water_level >= 20 and \n                machine.beans_level >= 10 and\n                isinstance(machine.get_current_state(), IdleState))\n\nclass RefillWaterCommand(CoffeeCommand):\n    def execute(self, machine: CoffeeMachine) -> None:\n        print(\"Refilling water tank...\")\n        machine.water_level = 100\n        print(\"Water tank refilled!\")\n    \n    def can_execute(self, machine: CoffeeMachine) -> bool:\n        return not isinstance(machine.get_current_state(), BrewingState)\n\nclass RefillBeansCommand(CoffeeCommand):\n    def execute(self, machine: CoffeeMachine) -> None:\n        print(\"Refilling bean hopper...\")\n        machine.beans_level = 100\n        print(\"Bean hopper refilled!\")\n    \n    def can_execute(self, machine: CoffeeMachine) -> bool:\n        return not isinstance(machine.get_current_state(), BrewingState)\n\nclass CleanMachineCommand(CoffeeCommand):\n    def execute(self, machine: CoffeeMachine) -> None:\n        print(\"Starting cleaning cycle...\")\n        machine.transition_to(MaintenanceState())\n    \n    def can_execute(self, machine: CoffeeMachine) -> bool:\n        return isinstance(machine.get_current_state(), IdleState)\n\nclass FinishBrewingCommand(CoffeeCommand):\n    def execute(self, machine: CoffeeMachine) -> None:\n        print(f\"{machine.current_coffee} is ready! ☕\")\n        machine.transition_to(IdleState())\n    \n    def can_execute(self, machine: CoffeeMachine) -> bool:\n        return isinstance(machine.get_current_state(), BrewingState)\n\nclass FinishMaintenanceCommand(CoffeeCommand):\n    def execute(self, machine: CoffeeMachine) -> None:\n        print(\"Maintenance complete! Machine is ready.\")\n        machine.transition_to(IdleState())\n    \n    def can_execute(self, machine: CoffeeMachine) -> bool:\n        return isinstance(machine.get_current_state(), MaintenanceState)\n\n# Concrete States\nclass IdleState(CoffeeMachineState):\n    def handle_command(self, machine: CoffeeMachine, command: CoffeeCommand) -> None:\n        if command.can_execute(machine):\n            command.execute(machine)\n        else:\n            print(\"Command cannot be executed: insufficient resources or wrong state\")\n    \n    def get_available_commands(self) -> List[str]:\n        return [\"brew_espresso\", \"brew_americano\", \"refill_water\", \"refill_beans\", \"clean_machine\"]\n    \n    def get_status(self) -> str:\n        return \"Idle - Ready to brew\"\n\nclass BrewingState(CoffeeMachineState):\n    def handle_command(self, machine: CoffeeMachine, command: CoffeeCommand) -> None:\n        if isinstance(command, FinishBrewingCommand):\n            command.execute(machine)\n        elif isinstance(command, (RefillWaterCommand, RefillBeansCommand)):\n            print(\"Cannot refill while brewing!\")\n        else:\n            print(\"Machine is busy brewing. Please wait...\")\n    \n    def get_available_commands(self) -> List[str]:\n        return [\"finish_brewing\"]\n    \n    def get_status(self) -> str:\n        return \"Brewing - Please wait\"\n\nclass MaintenanceState(CoffeeMachineState):\n    def handle_command(self, machine: CoffeeMachine, command: CoffeeCommand) -> None:\n        if isinstance(command, FinishMaintenanceCommand):\n            command.execute(machine)\n        else:\n            print(\"Machine is in maintenance mode. Complete maintenance first.\")\n    \n    def get_available_commands(self) -> List[str]:\n        return [\"finish_maintenance\"]\n    \n    def get_status(self) -> str:\n        return \"Maintenance - Cleaning in progress\"\n\n# Add method to get current state for context\ndef get_current_state(self) -> CoffeeMachineState:\n    return self._state\n\nCoffeeMachine.get_current_state = get_current_state\n\n# Client\ndef main() -> None:\n    # Create coffee machine\n    machine = CoffeeMachine()\n    \n    # Register commands\n    machine.register_command(\"brew_espresso\", BrewEspressoCommand())\n    machine.register_command(\"brew_americano\", BrewAmericanoCommand())\n    machine.register_command(\"refill_water\", RefillWaterCommand())\n    machine.register_command(\"refill_beans\", RefillBeansCommand())\n    machine.register_command(\"clean_machine\", CleanMachineCommand())\n    machine.register_command(\"finish_brewing\", FinishBrewingCommand())\n    machine.register_command(\"finish_maintenance\", FinishMaintenanceCommand())\n    \n    print(\"=== Coffee Machine State-Command Demo ===\")\n    print()\n    \n    # Show initial status\n    print(\"Initial status:\")\n    print(machine.get_status())\n    print(f\"Available commands: {machine.get_available_commands()}\")\n    print()\n    \n    # Brew espresso\n    print(\"-> Brewing espresso\")\n    machine.execute_command(\"brew_espresso\")\n    print(machine.get_status())\n    print(f\"Available commands: {machine.get_available_commands()}\")\n    print()\n    \n    # Try to brew another coffee while brewing\n    print(\"-> Trying to brew americano while brewing espresso\")\n    machine.execute_command(\"brew_americano\")\n    print()\n    \n    # Finish brewing\n    print(\"-> Finishing brewing\")\n    machine.execute_command(\"finish_brewing\")\n    print(machine.get_status())\n    print()\n    \n    # Multiple brews to trigger low resources\n    for i in range(3):\n        print(f\"-> Brewing americano #{i+1}\")\n        machine.execute_command(\"brew_americano\")\n        machine.execute_command(\"finish_brewing\")\n        print(f\"Water: {machine.water_level}%, Beans: {machine.beans_level}%\")\n        print()\n    \n    # Try to brew with low resources\n    print(\"-> Trying to brew with low resources\")\n    machine.execute_command(\"brew_americano\")\n    print()\n    \n    # Refill and clean\n    print(\"-> Refilling resources\")\n    machine.execute_command(\"refill_water\")\n    machine.execute_command(\"refill_beans\")\n    print()\n    \n    print(\"-> Starting maintenance\")\n    machine.execute_command(\"clean_machine\")\n    print(machine.get_status())\n    print(f\"Available commands: {machine.get_available_commands()}\")\n    print()\n    \n    print(\"-> Finishing maintenance\")\n    machine.execute_command(\"finish_maintenance\")\n    print(machine.get_status())\n\nif __name__ == \"__main__\":\n    main()"
