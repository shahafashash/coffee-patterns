            "",
            "    def get_current_state(self) -> ${3:State}:",
            "        \"\"\"",
            "        Get the current state.",
            "        ",
            "        Returns:",
            "            State: The current state instance.",
            "        \"\"\"",
            "        return self._state",
            "",
            "    def get_available_commands(self) -> List[str]:",
            "        \"\"\"",
            "        Get available commands for the current state.",
            "        ",
            "        Returns:",
            "            List[str]: List of available command names.",
            "        \"\"\"",
            "        return self._state.get_available_commands()",
            "",
            "# Concrete Commands",
            "class ${4:ConcreteCommandA}(${1:Command}):",
            "    \"\"\"",
            "    Concrete command implementation.",
            "    \"\"\"",
            "    def execute(self, context: ${2:Context}) -> None:",
            "        print(\"Executing ConcreteCommandA\")",
            "",
            "    def can_execute(self, context: ${2:Context}) -> bool:",
            "        # Define state-specific execution rules",
            "        return True",
            "",
            "class ${5:ConcreteCommandB}(${1:Command}):",
            "    \"\"\"",
            "    Another concrete command implementation.",
            "    \"\"\"",
            "    def execute(self, context: ${2:Context}) -> None:",
            "        print(\"Executing ConcreteCommandB\")",
