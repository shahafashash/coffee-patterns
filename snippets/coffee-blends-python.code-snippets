            "        Args:",
            "            state (State): The new state to transition to.",
            "        \"\"\"",
            "        print(f\"Context: Transitioning to {state.__class__.__name__}\")",
            "        self._state = state",
            "",
            "    def register_command(self, name: str, command: ${1:Command}) -> None:",
            "        \"\"\"",
            "        Register a command with the context.",
            "        ",
            "        Args:",
            "            name (str): The name of the command.",
            "            command (Command): The command instance.",
            "        \"\"\"",
            "        self._commands[name] = command",
            "",
            "    def execute_command(self, command_name: str) -> None:",
            "        \"\"\"",
            "        Execute a command by name.",
            "        ",
            "        Args:",
